# Mailtrap Live Sending credentials for the server only
MAILTRAP_SMTP_HOST=live.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=587
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASSWORD=
MAILTRAP_FROM_EMAIL=contact@njthnelvgn.com
CONTACT_ALLOWED_ORIGINS=https://njthnelvgn.com

# Public URL of the deployed function when using GitHub Pages
VITE_CONTACT_API_URL=

# Strapi CMS Configuration
# For local development, use: http://localhost:1337
# For Strapi Cloud, use your cloud instance URL (e.g., https://your-project.strapiapp.com)
VITE_STRAPI_URL=http://localhost:1337

# Optional: Strapi API token for authenticated requests
# Leave empty for public API access
VITE_STRAPI_TOKEN=
